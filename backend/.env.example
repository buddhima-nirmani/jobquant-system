# Copy this file to ".env" and fill in real values to enable the
# forgot-password feature to send actual emails. If these are left unset,
# JobQuant falls back to showing the reset link directly in the API
# response (dev mode) — no cost, no external service required.
#
# Gmail setup (free):
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Create an "App Password": myaccount.google.com/apppasswords
#   3. Use that 16-character app password below, NOT your normal Gmail password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_EMAIL=your-address@gmail.com

# Used to build the reset link inside the email. Point this at wherever the
# frontend is actually served.
FRONTEND_URL=http://localhost:3000

# Signs and verifies login tokens. If you don't set this, the app generates
# a random one on first run and saves it into your local .env automatically
# — you only need to set this yourself if you're deploying somewhere and
# want to control/rotate the value directly.
SECRET_KEY=
